{
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "src/**/*.html",
      "options": {
        "parser": "angular",
        "printWidth": 120
      }
    },
    {
      "files": "src/**/*.ts",
      "options": {
        "parser": "typescript",
        "printWidth": 100
      }
    },
    {
      "files": "src/**/*.{scss,css}",
      "options": {
        "parser": "scss",
        "printWidth": 100
      }
    },
    {
      "files": "./**/*.js",
      "options": {
        "parser": "babel",
        "printWidth": 100
      }
    },
    {
      "files": "./**/*.json",
      "options": {
        "parser": "json",
        "printWidth": 100,
        "trailingComma": "none"
      }
    },
    {
      "files": "./**/*.md",
      "options": {
        "parser": "markdown",
        "printWidth": 100,
        "proseWrap": "always"
      }
    }
  ]
}
